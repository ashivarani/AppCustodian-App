<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy Auto Backup Configuration File (Android 6.0 / API 23 to Android 11 / API 30).

  Note: This file is ignored on devices running Android 12 (API 31) or higher.
  For API 31+, Android uses `data_extraction_rules.xml` instead.

  See https://developer.android.com/guide/topics/data/autobackup for details.
-->
<full-backup-content>
    <!--
      Valid domain attributes:
        - "file" : App's internal storage directory (Context.getFilesDir())
        - "database" : App's SQLite databases directory (Context.getDatabasePath())
        - "sharedpref" : App's SharedPreferences directory (Context.getSharedPreferences())
        - "external" : App's primary external storage directory (Context.getExternalFilesDir())
        - "root" : Entire app storage directory

      Example usage:
      <include domain="sharedpref" path="."/>
      <exclude domain="sharedpref" path="device_specific_settings.xml"/>
      <exclude domain="database" path="cache.db"/>
    -->
</full-backup-content>