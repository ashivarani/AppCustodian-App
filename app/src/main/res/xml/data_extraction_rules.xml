<?xml version="1.0" encoding="utf-8"?>
<!--
  Modern Data Extraction Rules Configuration File (Android 12 / API 31+).

  Controls what data gets backed up to Google Cloud and what gets transferred
  during direct Device-to-Device (D2D) migration during setup.

  See https://developer.android.com/about/versions/12/backup-restore#xml-changes for details.
-->
<data-extraction-rules>

    <!-- Defines rules for cloud backup (Google Drive auto-backup) -->
    <cloud-backup>
        <!--
          Valid domain options: "root", "file", "database", "sharedpref", "external"

          Examples:
          <include domain="sharedpref" path="." />
          <exclude domain="sharedpref" path="device_specific_prefs.xml" />
          <exclude domain="database" path="temp_cache.db" />
        -->
    </cloud-backup>

    <!-- Defines rules for direct device-to-device transfers (cable / Wi-Fi setup) -->
    <device-transfer>
        <!--
          By default, if <device-transfer> is omitted, Android transfers all files.
          Uncomment and customize if you want different rules for D2D vs Cloud.

          Examples:
          <include domain="file" path="." />
          <exclude domain="sharedpref" path="auth_tokens.xml" />
        -->
    </device-transfer>

</data-extraction-rules>